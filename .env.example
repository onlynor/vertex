# 复制成 .env 后修改：cp .env.example .env
# 本地开发和 docker compose 都读这一个文件；.env 已在 .gitignore 里，不会提交。

# ===== AI 模型（任何 OpenAI 兼容接口：DeepSeek / 豆包 / Kimi / Qwen 等）=====
# 视频分析、AI 一键评价、评语和课堂总评都用这一个模型，需要支持图片输入
# 这里的值只作为首次启动的兜底，登录后可在「设置」页修改，之后以数据库中的加密配置为准
API_KEY=your-api-key
base_url=https://api.deepseek.com/
model=deepseek-v4-flash-vision-exp

# ===== MySQL =====
# docker compose 会自动建库，DB_HOST 用服务名 mysql（compose 文件里已写好，不用改这里）
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=football_ai

# ===== 安全 =====
# JWT 签名 + 数据库字段加密（报告正文、封面图、学生评价与评语、API Key）的主密钥
# 换掉它会导致已存的加密数据无法解密，生产环境请改成一段足够长的随机字符串
APP_SECRET=change-me-to-a-long-random-string

# 首次启动、teachers 表为空时自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 训练视频保留 =====
# 视频保存在磁盘上供回放；超过容量上限后按最旧优先淘汰
VIDEO_STORE_DIR=./data/videos
VIDEO_STORE_MAX_GB=20

# ===== 服务 =====
# 抽帧临时目录（分析结束即清理）与后端监听端口，一般无需改动
VIDEO_TMP_DIR=./tmp
PORT=8080

# ===== docker compose =====
# 网站对外端口；默认 8080，避免和很多机器上已经在跑的系统级 80 端口 nginx 冲突。
# 改成别的端口（比如 80）就访问 http://服务器地址:改成的端口/
WEB_PORT=8080
# 监听地址：留空即 0.0.0.0，外网能直接访问。
# 前面套了反代（Nginx / Caddy）时改成 127.0.0.1，容器端口就只有本机能连，
# 外部请求全部走反代转发，不会绕过反代直接打到这个端口。
WEB_HOST=0.0.0.0
# 时区：评价表、训练报告按本地日期统计，保持和学校一致
TZ=Asia/Shanghai

# 构建镜像时的下载源，默认国内镜像，构建更快更稳；不填就用这里写的默认值。
# 海外服务器构建慢或访问不了下面这些镜像时，改成对应的官方源：
#   GOPROXY=https://proxy.golang.org
#   GOSUMDB=sum.golang.org
#   APK_MIRROR=dl-cdn.alpinelinux.org
#   NPM_REGISTRY=https://registry.npmjs.org
GOPROXY=https://goproxy.cn,https://proxy.golang.com.cn,direct
GOSUMDB=sum.golang.google.cn
APK_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com/
